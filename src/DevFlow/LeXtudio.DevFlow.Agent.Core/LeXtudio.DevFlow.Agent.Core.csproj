  <ItemGroup>
    <!-- CliclickSharp native helper. One item serves three consumers:
         * Own build + ProjectReference consumers — CopyToOutputDirectory flows transitively.
         * NuGet package — Pack=true places it at build/CliclickSharp, next to the .targets that
           copies it into a PackageReference consumer's output (contentFiles copyToOutput is
           unreliable for a bare native binary, so the build/.targets is the reliable path). -->
    <None Include="..\..\..\external\cliclick-sharp\dist\CliclickSharp" Pack="true" PackagePath="build\;buildTransitive\">
      <Link>CliclickSharp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\..\external\cliclick-sharp\dist\CliclickSharp.exe" Pack="true" PackagePath="build\;buildTransitive\">
      <Link>CliclickSharp.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <!-- buildTransitive/ as well as build/: build/ is imported only by DIRECT package references, so a
         consumer that references an agent package (which depends on this one) would never import these
         targets and would silently fall back to whatever `cliclick` is on PATH - the original, whose
         drag is left-button only. -->
    <None Include="build\LeXtudio.DevFlow.Agent.Core.targets" Pack="true" PackagePath="build\LeXtudio.DevFlow.Agent.Core.targets;buildTransitive\LeXtudio.DevFlow.Agent.Core.targets" Visible="false" />
  </ItemGroup>

